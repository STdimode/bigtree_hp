            </button>
            <button id="gallery-pc-next" class="cms-circle-nav-btn">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="cms-icon-sm"><path d="m9 18 6-6-6-6"/></svg>
            </button>
          </div>
          <!-- Mobile: Arrow buttons -->
          <div class="cms-nav-controls-mobile flex md:hidden">
            <button id="gallery-mob-prev" class="cms-circle-nav-btn">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="cms-icon-sm"><path d="m15 18-6-6 6-6"/></svg>
            </button>
            <span id="gallery-mob-indicator" class="cms-nav-indicator-sm">1 / 3</span>
            <button id="gallery-mob-next" class="cms-circle-nav-btn">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="cms-icon-sm"><path d="m9 18 6-6-6-6"/></svg>
            </button>
          </div>
        </div>

        <!-- Divider -->
        <div class="cms-divider-gallery"></div>

        <!-- Desktop Carousel -->
        <div id="gallery-scroll" class="cms-gallery-carousel hidden md:flex">
          <!-- Injected via JS -->
        </div>

        <!-- Mobile: 2 items per page -->
        <div class="md:hidden">
          <div id="gallery-mob-container" class="cms-gallery-mob-grid">
            <!-- Injected via JS -->
          </div>
        </div>

        <!-- All view link -->
        <div class="cms-gallery-view-all">
          <a href="#" class="cms-view-all-link-center group/link">
            view all
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cms-icon-sm-fade group-hover/link:opacity-100"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- Welcome Section -->
    <section id="welcome" class="cms-welcome-section fade-up">
      <!-- Background with parallax -->
      <div id="welcome-bg" class="cms-welcome-bg-wrap">
        <img
          src="/UserData/bigtreech/Layouts/bigtreech_Layout/images/welcome_bg.jpg"
          alt="Welcome"
          class="cms-welcome-bg-img"
        />
        <div class="cms-welcome-bg-overlay"></div>
      </div>

      <div class="cms-welcome-content">
        <!-- Label -->
        <p class="cms-welcome-tag">WELCOME NEW FAMILY</p>
        <!-- Heading -->
        <h2 class="cms-welcome-heading">큰나무의 그늘 아래서<br />함께 쉼을 얻고 뿌리 내리세요</h2>
        <!-- Body -->
        <p class="cms-welcome-body">
          큰나무의 그늘 아래서 함께 쉼을 얻고 뿌리 내릴 수 있도록<br />
          새가족을 위한 따뜻한 안내를 준비했습니다.<br />
          아래 버튼을 클릭하시면 자세한 등록 과정을 살펴보실 수 있습니다.
        </p>
        <!-- CTA -->
        <a href="#" class="cms-welcome-cta">새가족 등록 안내</a>
      </div>
    </section>

  </main>

  <!-- Footer -->
  <footer class="cms-footer">
    <div class="cms-container-fluid">
      <!-- Top: Logo -->
      <div class="cms-footer-logo-wrap">
        <img src="/UserData/bigtreech/Layouts/bigtreech_Layout/images/footer_logo.png" alt="큰나무교회 로고" class="cms-footer-logo" />
      </div>

      <!-- Bottom: Info left + Copyright right -->
      <div class="cms-footer-bottom">
        <!-- Left: Contact & Address -->
        <div class="cms-footer-info">
          <p class="cms-footer-text">
            <span class="cms-footer-label">TEL</span> 070-8680-5160, 02-2665-1132
            <span class="cms-footer-spacer"></span>
            <span class="cms-footer-label">FAX</span> 02-2663-1097
          </p>
          <p class="cms-footer-text">
            <span class="cms-footer-label">MAIL</span> BIGTREE@BIGTREE.OR.KR
            <span class="cms-footer-spacer"></span>
            <span class="cms-footer-label">ADDRESS</span> 서울시 강서구 금낭화로 232 큰나무교회
          </p>
        </div>

        <!-- Right: Copyright -->
        <div class="cms-footer-copyright">
          <p class="cms-footer-text">
            COPYRIGHT &copy; 2026 큰나무교회<br />
            ALL RIGHTS RESERVED. DESIGNED BY (주)소네트정보
          </p>
        </div>
      </div>
    </div>
  </footer>
</div>

