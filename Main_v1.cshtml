      <div class="cms-container">
        <!-- Section Header -->
        <div class="cms-section-header">
          <div class="cms-section-title-wrap">
            <h2 class="cms-section-title">GALLERY</h2>
          </div>
          <!-- Desktop: Arrow buttons -->
          <div class="cms-nav-controls-desktop hidden md:flex">
            <button id="gallery-pc-prev" class="cms-circle-nav-btn">
