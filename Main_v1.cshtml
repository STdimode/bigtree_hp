          <div class="cms-nextgen-subtitle-wrap">
            <p class="cms-nextgen-subtitle">
              큰나무교회의 미래,<br />다음세대입니다.
            </p>
          </div>

          <!-- Right: 3-col department grid -->
          <div class="cms-nextgen-grid" id="nextgen-grid">
            <!-- Injected via JS -->
          </div>
        </div>
      </div>
    </section>

    <!-- Gallery -->
